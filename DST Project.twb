      <aliases enabled='yes' />
      <column caption='Orders' datatype='integer' name='[Calculation_0238033362395136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Delivered Orders' datatype='integer' name='[Calculation_0238033362620418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_delivered] THEN [order_id] END)' />
      </column>
      <column caption='Late Orders' datatype='integer' name='[Calculation_0238033363193859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_delivered] AND [is_late] THEN [order_id] END)' />
      </column>
      <column caption='Late Delivery Rate' datatype='real' name='[Calculation_0238033363267588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0238033363193859] / [Calculation_0238033362620418]' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_0238033363509253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([item_revenue])' />
      </column>
      <column caption='Revenue - Late Orders' datatype='real' name='[Calculation_0238033363734534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_late] THEN [item_revenue] END)' />
      </column>
      <column caption='Revenue at Risk %' datatype='real' name='[Calculation_0238033363812359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0238033363734534] / [Calculation_0238033363509253]' />
      </column>
      <column caption='Avg Review Score' datatype='real' name='[Calculation_0238033363910664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [order_item_id] = 1 THEN [review_score] END)' />
      </column>
      <column caption='Avg Review - Late' datatype='real' name='[Calculation_0238033363992585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [order_item_id] = 1 AND [is_late] THEN [review_score] END)' />
      </column>
      <column caption='Avg Review - On Time' datatype='real' name='[Calculation_0238033364054026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [order_item_id] = 1 AND [is_delivered] AND NOT [is_late] THEN [review_score] END)' />
      </column>
      <column caption='Seller Delivered Orders' datatype='integer' name='[Calculation_0238033364201483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [seller_id] : COUNTD(IF [is_delivered] THEN [order_id] END) }' />
      </column>
      <column caption='Seller Late Orders' datatype='integer' name='[Calculation_0238033364381708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [seller_id] : COUNTD(IF [is_delivered] AND [is_late] THEN [order_id] END) }' />
      </column>
      <column caption='Seller Late Rate' datatype='real' name='[Calculation_0238033364439053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0238033364381708] / [Calculation_0238033364201483]' />
      </column>
      <column caption='Seller Flag' datatype='string' name='[Calculation_0238033364508686]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0238033364201483] &gt;= 30 AND [Calculation_0238033364439053] &gt; 0.15 THEN &quot;Flagged&quot; ELSE &quot;OK&quot; END' />
      </column>
      <column caption='Projected Recovered Revenue' datatype='real' name='[Calculation_0238033365344272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0238033363734534] * [Parameters].[Parameter 0238033364680719]' />
      </column>
      <column caption='olist_tableau_flat.csv' datatype='table' name='[__tableau_internal_object_id__].[olist_tableau_flat.csv_567F71F03AFE42F992549CEC1013E723]' role='measure' type='quantitative' />
      <column caption='Customer City' datatype='string' name='[customer_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
